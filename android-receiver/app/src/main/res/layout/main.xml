<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black">
    <androidx.media3.ui.PlayerView android:id="@+id/player"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:surface_type="surface_view" app:show_buffering="when_playing"
        app:show_timeout="4000" app:use_controller="true" />
    <dev.framextv.lumareceiver.SubtitleOverlay android:id="@+id/captions"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/idle" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:gravity="center" android:background="#0B3D2E" android:padding="48dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="40sp" />
        <TextView android:id="@+id/idle_status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:gravity="center" android:textColor="#CCFFFFFF" android:textSize="20sp" />
        <TextView android:id="@+id/pairing_code" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:textColor="#FFE082" android:textSize="72sp" android:letterSpacing="0.2"
            android:visibility="gone" />
        <TextView android:id="@+id/update_prompt" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:gravity="center" android:textColor="#FFE082" android:textSize="20sp"
            android:visibility="gone" />
        <TextView android:id="@+id/footer" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:gravity="center" android:textColor="#88FFFFFF" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/scrub" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp" android:orientation="vertical" android:gravity="center_horizontal"
        android:background="#B3000000" android:padding="12dp" android:visibility="gone">
        <ImageView android:id="@+id/scrub_image" android:layout_width="384dp" android:layout_height="216dp"
            android:scaleType="fitCenter" android:visibility="gone" />
        <TextView android:id="@+id/scrub_time" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="#FFFFFF" android:textSize="26sp" />
        <ProgressBar android:id="@+id/scrub_bar" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="384dp" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="1000" />
    </LinearLayout>
    <TextView android:id="@+id/notice" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp" android:background="#CC000000" android:padding="16dp"
        android:textColor="#FFFFFF" android:textSize="20sp" android:visibility="gone" />
</FrameLayout>
