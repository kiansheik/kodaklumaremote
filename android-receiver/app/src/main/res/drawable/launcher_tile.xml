<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#3A7065" />
            <stroke android:width="4dp" android:color="#FFF1A6" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#285A51" />
            <stroke android:width="4dp" android:color="#FFE082" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#173F3A" />
            <stroke android:width="1dp" android:color="#557B75" />
        </shape>
    </item>
</selector>
