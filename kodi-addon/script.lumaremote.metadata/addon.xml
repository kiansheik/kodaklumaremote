<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.lumaremote.metadata" name="LUMA Remote Metadata" version="1.0.0" provider-name="LUMA Remote">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Open LUMA Remote media with canonical playback metadata</summary>
    <description lang="en_GB">Receives a bounded LUMA v1 handoff from the companion app and starts the exact public media source with movie or episode metadata.</description>
    <platform>all</platform>
    <license>All rights reserved</license>
  </extension>
</addon>
