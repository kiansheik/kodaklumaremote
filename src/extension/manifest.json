{
  "manifest_version": 3,
  "name": "frameXTV Native Cast",
  "version": "0.1.0",
  "description": "Cast an exposed media source using the page’s existing Google Cast SDK.",
  "minimum_chrome_version": "111",
  "content_scripts": [{
    "matches": ["https://framextv.xyz/*"],
    "js": ["player.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "world": "MAIN"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
